# 复制为 .env 后填写。所有配置都集中在 src/pagent/config.py 里读取。

# ---------------- 1. 对话模型（LLM） ----------------
# LLM_PROVIDER 可选:
#   anthropic   -> Claude 原生接口（也可用于兼容 Anthropic 协议的厂商，如 DeepSeek 的 /anthropic 端点）
#   openai      -> OpenAI 接口，或任何 OpenAI 兼容服务（DeepSeek / 通义千问 / Kimi / 智谱 / Ollama / vLLM）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# 留空用官方地址；用兼容服务时填它的 base_url
LLM_BASE_URL=

# 示例：DeepSeek（OpenAI 兼容）
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...

# 示例：本地 Ollama
# LLM_PROVIDER=openai
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# ---------------- 2. 向量模型（Embedding） ----------------
# fastembed -> 本地 ONNX 模型，免费、离线，首次运行会下载约 100MB（默认 BAAI/bge-small-zh-v1.5，中文友好）
# openai    -> 任何 OpenAI 兼容的 /embeddings 接口（如 DashScope text-embedding-v4）
# hash      -> 纯本地的哈希“伪向量”，不下载任何模型，效果差，仅用于离线测试
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------------- 3. 可观测性（可选） ----------------
# 打开后每一次模型调用/工具调用都能在 LangSmith 上看到完整链路
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=personal-agent
